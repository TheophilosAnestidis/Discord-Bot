# VaultX
CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
BOT_TOKEN=your_discord_bot_token
OWNER_USER_ID=your_discord_user_id
GUILD_ID=your_test_guild_id

# Dashboard (separate service)
DASHBOARD_PORT=3000
DASHBOARD_REDIRECT_URI=http://localhost:3000/auth/callback
PUBLIC_URL=http://localhost:3000

# Discord Activity (separate service)
ACTIVITY_PORT=5173
ACTIVITY_URL=http://localhost:5173

# Admin panel — password-only, 10 minute sessions
ADMIN_PASSWORD=choose_a_strong_admin_password

# Payments — optional but required for live online checkout
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
TICKET_AUTO_CLOSE_HOURS=1

# Optional public links shown in the dashboard
SUPPORT_URL=
TERMS_URL=
PRIVACY_URL=

# AI
AI_TESTER_USER_IDS=your_discord_user_id
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free